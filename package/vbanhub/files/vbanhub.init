#!/bin/sh /etc/rc.common

. /lib/functions/network.sh

USE_PROCD=1
EXTRA_COMMANDS="scan prune setvol"
EXTRA_HELP="	scan	Scan the LAN for VBAN devices (PING0)
	prune	Delete routes whose endpoints no longer exist
	setvol	<main|route-id> <0-200> <0|1>  Set volume percent and mute, applied instantly"
START=60
STOP=10

CONF=/var/etc/vbanhub.conf

gen_route() {
	local from to sip sstream dip dport dstream en gain mute
	config_get_bool en "$1" enabled 1
	[ "$en" = 1 ] || return 0
	config_get from "$1" from
	config_get to "$1" to
	[ -n "$from" ] && [ -n "$to" ] || return 0
	# No wildcard source: a route must be bound to a transmitter IP and stream.
	config_get sip "$from" ip
	config_get sstream "$from" stream
	config_get dip "$to" ip
	config_get dport "$to" port 6980
	config_get dstream "$to" stream
	[ -n "$sip" ] && [ -n "$sstream" ] && [ -n "$dip" ] && [ -n "$dstream" ] || return 0
	# The daemon config is TAB-separated, so stream names may contain spaces.
	# Reject tabs/newlines, the '*' wildcard, whitespace in ip/port, and names over 16 bytes.
	case "$sip$dip$dport" in
		*[[:space:]]*|*'*'*) logger -t vbanhub "route $1 skipped: bad address"; return 0 ;;
	esac
	local tab="$(printf '\t')" nl="
"
	case "$sstream$dstream" in
		*"$tab"*|*"$nl"*) logger -t vbanhub "route $1 skipped: stream name has tab/newline"; return 0 ;;
	esac
	if [ "$sstream" = '*' ] || [ "$dstream" = '*' ] || [ ${#sstream} -gt 16 ] || [ ${#dstream} -gt 16 ]; then
		logger -t vbanhub "route $1 skipped: stream name invalid (max 16 chars, not '*')"; return 0
	fi
	# Volume: percent (0-200, 100 = unchanged); mute sends silence without losing the level.
	config_get gain "$1" gain 100
	config_get_bool mute "$1" mute 0
	case "$gain" in *[!0-9]*|'') gain=100 ;; esac
	[ "$gain" -gt 200 ] && gain=200
	[ "$mute" = 1 ] && gain=0
	printf 'route\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sip" "$sstream" "$dip" "$dport" "$dstream" "$gain" >> $CONF
}

gen_conf() {
	mkdir -p /var/etc
	local mgain mmute
	echo "# generated from /etc/config/vbanhub" > $CONF
	config_get mgain main gain 100
	config_get_bool mmute main mute 0
	case "$mgain" in *[!0-9]*|'') mgain=100 ;; esac
	[ "$mgain" -gt 200 ] && mgain=200
	[ "$mmute" = 1 ] && mgain=0
	printf 'master\t%s\n' "$mgain" >> $CONF
	config_foreach gen_route route
}

# Announce the hub via umdns (_vban._udp). Written to flash only when changed.
gen_mdns() {
	local want="$1" port="$2" f=/etc/umdns/vbanhub.json new
	[ -d /etc/umdns ] || return 0
	if [ "$want" = 1 ]; then
		new="{\"vbanhub\":{\"service\":\"_vban._udp.local\",\"port\":$port,\"txt\":[\"hub=1\",\"role=receiver,transmitter\"]}}"
		[ "$(cat $f 2>/dev/null)" = "$new" ] || echo "$new" > $f
	else
		[ -f $f ] && rm -f $f || return 0
	fi
	ubus -t 1 call umdns reload 2>/dev/null
	return 0
}

scan() {
	pidof vbanhub >/dev/null || { echo "vbanhub is not running (enable it in LuCI and apply)" >&2; return 1; }
	procd_send_signal vbanhub '*' USR1
}

# ---- firewall: open UDP <port> for the zones of the selected networks (never WAN / masq zones) ----
# Zones whose input policy already ACCEPTs (default lan) need no rule. Rules are named vbanhub_<zone>
# and only touched when they differ from what is wanted, so a normal restart does not reload fw4.
zone_of_net() {
	local net="$1" i=0 nets
	while uci -q get "firewall.@zone[$i]" >/dev/null; do
		nets="$(uci -q get "firewall.@zone[$i].network")"
		case " $nets " in *" $net "*) echo "$i"; return 0 ;; esac
		i=$((i + 1))
	done
	return 1
}

fw_collect() {   # config_list_foreach callback: append to FW_WANT
	local net="$1" z name input masq
	z="$(zone_of_net "$net")" || return 0
	name="$(uci -q get "firewall.@zone[$z].name")"
	input="$(uci -q get "firewall.@zone[$z].input")"
	masq="$(uci -q get "firewall.@zone[$z].masq")"
	[ -n "$name" ] || return 0
	if [ "$name" = wan ] || [ "$masq" = 1 ]; then return 0; fi
	[ "$input" = ACCEPT ] && return 0
	case " $FW_WANT_ZONES " in *" $name "*) return 0 ;; esac
	FW_WANT_ZONES="$FW_WANT_ZONES $name"
	FW_WANT="$FW_WANT
vbanhub_$name $name $FW_PORT"
}

fw_rule_secs() {
	uci -q show firewall | sed -n 's/^firewall\.\(vbanhub_[A-Za-z0-9_]*\)=rule$/\1/p'
}

fw_sync() {   # $1 = port to open, or empty to remove all vbanhub rules
	local have sec zone port
	FW_PORT="$1"; FW_WANT=""; FW_WANT_ZONES=""
	[ -n "$FW_PORT" ] && config_list_foreach main network fw_collect
	have="$(for sec in $(fw_rule_secs); do
		echo "$sec $(uci -q get firewall.$sec.src) $(uci -q get firewall.$sec.dest_port)"; done | sort)"
	[ "$have" = "$(echo "$FW_WANT" | sed '/^$/d' | sort)" ] && return 0

	for sec in $(fw_rule_secs); do uci -q delete firewall.$sec; done
	echo "$FW_WANT" | sed '/^$/d' | while read -r sec zone port; do
		uci set firewall.$sec=rule
		uci set firewall.$sec.name="Allow-VBANHub-$zone"
		uci set firewall.$sec.src="$zone"
		uci set firewall.$sec.proto=udp
		uci set firewall.$sec.dest_port="$port"
		uci set firewall.$sec.family=ipv4
		uci set firewall.$sec.target=ACCEPT
	done
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t vbanhub "firewall rules updated"
}

# Map a logical network (lan, guest, ...) to its L3 device; fall back to the configured device.
add_net() {
	local dev=""
	network_get_device dev "$1"
	[ -n "$dev" ] || dev="$(uci -q get network."$1".device)"
	[ -n "$dev" ] || return 0
	procd_append_param command -i "$dev"
	NETS_ADDED=1
}

append_target() {
	procd_append_param command -T "$1"
}

service_triggers() {
	procd_add_reload_trigger vbanhub
}

# Delete routes whose transmitter or receiver endpoint no longer exists. Runs on every start/reload,
# so removing an endpoint (LuCI, uci, ...) cleans up after itself. A second run finds nothing to do.
prune_routes() {
	local sec from to n=0
	for sec in $(uci -X show vbanhub 2>/dev/null | sed -n 's/^vbanhub\.\([^.=]*\)=route$/\1/p'); do
		from="$(uci -q get vbanhub.$sec.from)"; to="$(uci -q get vbanhub.$sec.to)"
		if [ -z "$from" ] || [ -z "$to" ] ||
		   [ "$(uci -q get vbanhub.$from)" != endpoint ] || [ "$(uci -q get vbanhub.$to)" != endpoint ]; then
			uci -q delete vbanhub.$sec && n=$((n + 1))
		fi
	done
	if [ "$n" -gt 0 ]; then
		uci commit vbanhub
		logger -t vbanhub "removed $n route(s) whose endpoint no longer exists"
	fi
}

prune() {
	prune_routes
}

# Volume knob used by LuCI (its session may not be allowed to call 'uci apply'): validates strictly,
# commits and re-reads the routes without restarting or dropping packets.
setvol() {
	local sec="$1" gain="$2" mute="$3"
	case "$sec" in ''|*[!A-Za-z0-9_]*) echo "bad section" >&2; return 1 ;; esac
	case "$gain" in ''|*[!0-9]*) echo "bad gain" >&2; return 1 ;; esac
	case "$mute" in 0|1) ;; *) echo "bad mute" >&2; return 1 ;; esac
	[ "$gain" -gt 200 ] && gain=200
	if [ "$sec" != main ]; then
		[ "$(uci -q get vbanhub.$sec)" = route ] || { echo "no such route (save the page first)" >&2; return 1; }
	fi
	uci set vbanhub.$sec.gain="$gain"
	uci set vbanhub.$sec.mute="$mute"
	uci commit vbanhub
	reload_service
}

reload_service() {
	prune_routes
	# Changed settings (port, networks, scan, name...) or a service that is not running yet (just enabled
	# in LuCI) need a full restart; a route-only change just re-reads the routes without dropping packets.
	if ! pidof vbanhub >/dev/null || [ "$(uci -q show vbanhub.main | grep -v '\.\(gain\|mute\)=' | md5sum)" != "$(cat /var/run/vbanhub.sig 2>/dev/null)" ]; then
		restart
		return
	fi
	config_load vbanhub
	gen_conf
	procd_send_signal vbanhub   # SIGHUP: reload routes, no packet loss
}

start_service() {
	local enabled port dscp mdns iface scan_interval scan_ports openfw hub_name
	prune_routes
	uci -q show vbanhub.main | grep -v '\.\(gain\|mute\)=' | md5sum > /var/run/vbanhub.sig
	config_load vbanhub
	config_get_bool enabled main enabled 0
	config_get port main port 6980
	config_get dscp main dscp 46
	config_get_bool mdns main mdns 1
	if [ "$enabled" != 1 ]; then
		gen_mdns 0 "$port"
		fw_sync ""
		return 0
	fi
	gen_conf
	gen_mdns "$mdns" "$port"
	config_get_bool openfw main open_firewall 1
	if [ "$openfw" = 1 ]; then fw_sync "$port"; else fw_sync ""; fi

	procd_open_instance
	# Bind to one interface (default: the LAN device) so the WAN never reaches it.

	# Unprivileged: runs as nobody; only the state dir is writable.
	mkdir -p /var/run/vbanhub
	chown nobody:nogroup /var/run/vbanhub 2>/dev/null || chown nobody /var/run/vbanhub
	chmod 755 /var/run/vbanhub
	chmod 644 $CONF

	procd_set_param command /usr/sbin/vbanhub -p "$port" -t "$dscp" -c $CONF -s /var/run/vbanhub/status.json
	# Listen only on the selected networks (LuCI: Listen on networks). Fail closed.
	NETS_ADDED=0
	config_list_foreach main network add_net
	if [ "$NETS_ADDED" = 0 ]; then
		config_get iface main iface            # legacy: a device name
		if [ -n "$iface" ] && [ "$iface" != "*" ]; then
			procd_append_param command -i "$iface"
		else
			add_net lan
			[ "$NETS_ADDED" = 1 ] || procd_append_param command -i none
		fi
	fi
	config_get hub_name main hub_name
	[ -n "$hub_name" ] || hub_name="$(cat /proc/sys/kernel/hostname 2>/dev/null) VBAN hub"
	procd_append_param command -N "$hub_name"
	config_get scan_interval main scan_interval 0
	config_get scan_ports main scan_ports 6980
	case "$scan_interval" in *[!0-9]*|'') scan_interval=0 ;; esac
	case "$scan_ports" in *[!0-9,]*|'') scan_ports=6980 ;; esac
	procd_append_param command -S "$scan_interval" -P "$scan_ports"
	config_list_foreach main scan_target append_target
	procd_set_param user nobody
	procd_set_param respawn
	procd_set_param limits nofile=64
	procd_close_instance
}
