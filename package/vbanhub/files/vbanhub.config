config vbanhub 'main'
	option enabled '0'
	# Master volume (percent, applied on top of each route) and mute:
	#option gain '100'
	#option mute '0'
	option port '6980'
	option dscp '46'
	option mdns '1'
	# Name shown to VBAN apps that ping the hub (default: "<hostname> VBAN hub").
	#option hub_name 'Studio hub'
	# Open UDP <port> in the firewall for the zones of the selected networks (never WAN).
	option open_firewall '1'
	# Kernel fast path (needs package vbanhub-fastpath): routes at 100 % volume are forwarded by a
	# tc eBPF program inside the kernel. Packets it forwards bypass the firewall (only routed
	# senders are forwarded, to the configured receivers). 0 = the daemon forwards everything.
	option fastpath '1'
	# With the fast path: turn fraglist GRO (rx-gro-list) off on the listen bridge's ports while
	# the hub runs. Otherwise merged packet pairs fall back to the daemon and arrive late and
	# out of order. Costs some CPU for other bulk traffic the router forwards in software.
	option fastpath_gro_off '1'
	# Secure VBAN from the internet (needs a CA, see the Security tab). Only authenticated,
	# encrypted packets are accepted on this network; plain VBAN and pings never are. Opens the
	# hub port in that network's firewall zone.
	option internet '0'
	option internet_network 'wan'
	# LAN discovery (VBAN PING0). 0 = only when you press Scan / run '/etc/init.d/vbanhub scan'.
	option scan_interval '0'
	option scan_ports '6980'
	# Extra unicast scan targets (other subnets / Wi-Fi clients that drop broadcast):
	#list scan_target '192.168.2.50'
	# Networks to listen on (pick in LuCI). Packets from other interfaces are dropped.
	list network 'lan'

# Example endpoints (tx = transmitter, rx = receiver).
# 'stream' is the stream name the endpoint sends (tx) or expects (rx).
#config endpoint 'mic_pc'
#	option name 'Studio PC'
#	option role 'tx'
#	option ip '192.168.1.10'
#	option stream 'Mic1'
#
#config endpoint 'phone'
#	option name 'Phone'
#	option role 'rx'
#	option ip '192.168.1.20'
#	option port '6980'
#	option stream 'Stream1'
#
# A secure-VBAN device (SDK): matched by its certificate name, IP not needed.
#config endpoint 'studio_pc'
#	option name 'Studio PC (secure)'
#	option role 'tx'
#	option cert 'Studio PC'
#
# One route section per matrix cell (tx -> rx):
#config route
#	option from 'mic_pc'
#	option to 'phone'
#	option enabled '1'	# 0 = keep the route but pause it
#	option gain '100'	# volume in percent (0-200)
#	option mute '0'	# 1 = send silence
